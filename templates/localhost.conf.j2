# {{ ansible_managed }}

# localhost virtual host for server-status and other things for munin stats
<VirtualHost 127.0.0.1:{{ apache_localhost_port | default('80') }}>
  ServerName 127.0.0.1
  ServerAlias localhost
  StrictHostCheck on
  <IfModule suexec_module>
    SuexecUserGroup www-data www-data
  </IfModule>
  <IfModule status_module>
    <Location /server-status>
      SetHandler server-status
      Require local
    </Location>
  </IfModule>
  <IfModule md_module>
    <Location "/md-status">
      SetHandler md-status
      Require local
    </Location>
  </IfModule>
{% if apache_php | ansible.builtin.bool and apache_php_version is ansible.builtin.defined %}
  <IfModule proxy_fcgi>
    <IfFile "/run/php/php{{ apache_php_version }}-fpm.sock">
      <Location /status>
        SetHandler "proxy:unix:/run/php/php{{ apache_php_version }}-fpm.sock|fcgi://localhost/"
        Require local
      </Location>
    </IfFile>
  </IfModule>
{% endif %}
  IncludeOptional /etc/apache2/localhost.d/*.conf
  DocumentRoot "/var/www/localhost"
  <Directory "/var/www/localhost">
    Options +Indexes +SymlinksIfOwnerMatch -MultiViews -Includes -ExecCGI
    AllowOverride AuthConfig Indexes FileInfo Limit
    Require local
{% if apache_php | ansible.builtin.bool and apache_php_version is ansible.builtin.defined %}
    <IfModule proxy_fcgi_module>
      <IfModule setenvif_module>
        SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
      </IfModule>
      <IfFile "/run/php/php{{ apache_php_version }}-fpm.sock">
        <FilesMatch "\.php$">
          <If "-f %{REQUEST_FILENAME}">
            SetHandler "proxy:unix:/run/php/php{{ apache_php_version }}-fpm.sock|fcgi://localhost/"
          </If>
        </FilesMatch>
      </IfFile>
    </IfModule>
{% endif %}
  </Directory>
</VirtualHost>

