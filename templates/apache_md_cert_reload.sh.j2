set -eE

# This script needs to be run as root
if [[ "$(id -u)" != "0" ]] ; then
  echo "The ${0} script can only be run by root"
  exit 1
fi

# Check that apache2ctl is available
if ! command -v /usr/sbin/apache2ctl &> /dev/null
then
  echo "apache2ctl could not be found"
  exit 1
fi

# Check if one of more /etc/apache2/md/staging/*/pubcert*pem files exist
pubcert=$(find /etc/apache2/md/staging -name pubcert.pem -type f | head -n1)
pubcert_secp384r1=$(find /etc/apache2/md/staging -name pubcert.secp384r1.pem -type f | head -n1)

# Reload Apache when staging cert(s) exist
if [[ -f "${pubcert}" || -f "${pubcert_secp384r1}" ]]
then
  echo "Reloading Apache for new certificates"
  /usr/sbin/service apache2 reload
  exit 0
fi

